#!/bin/sh
# Deterministic: compiles and packages a fresh .vsix for the just-bumped version into build/.
# Calls the canonical shared script in ~/.agents/skills/smarts-app-vscode/ghooks/
# (reused by every VS Code extension project) — never a per-project copy.
ROOT="$(git rev-parse --show-toplevel)"
node "$HOME/.agents/skills/smarts-app-vscode/ghooks/auto-version-build.mjs" post-commit "$ROOT"
