.vscode/**
.claude/**
src/**
node_modules/**
**/*.map
**/tsconfig.json
.gitignore
.DS_Store
CLAUDE.md
.vscodeignore
build/**
*.vsix

# Stray scratch output dropped at the project root by an unrelated task
# (e.g. a skill's own working folder) — never a real extension asset.
domain/**

# The auto memory system's project-memory folder — session/assistant memory
# state, never a real extension asset.
memory/**
MEMORY.md

# claude-memory plugin's own runtime scratch state (session-slug, save
# locks, capture-alive markers) — churns constantly mid-session, and its
# transient lock files (.remember/tmp/save.lock/pid) can vanish between
# vsce's file enumeration and its secretlint scan pass, crashing the whole
# `vsce package` step with an ENOENT. Never a real extension asset either way.
.remember/**

# Any root-level Markdown other than the user-facing docs — catches stray
# session artifacts (e.g. a skill-generated "*Roadmap N.md") that sit
# untracked at the project root and would otherwise leak into the .vsix.
*.md
!README.md
!readme.md
!CHANGELOG.md
!changelog.md

# Root-level scratch/debugging scripts left over from earlier sessions
# (e.g. _launch_sample.cmd, _launch_sample_diag1.cmd, _verify_png.mjs) —
# never a real extension asset.
_*
