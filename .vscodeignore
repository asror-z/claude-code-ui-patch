.vscode/**
.claude/**
src/**
node_modules/**
**/*.map
**/tsconfig.json
.gitignore
.DS_Store
CLAUDE.md
.vscodeignore
build/**
*.vsix

# Stray scratch output dropped at the project root by an unrelated task
# (e.g. a skill's own working folder) — never a real extension asset.
domain/**

# The auto memory system's project-memory folder — session/assistant memory
# state, never a real extension asset.
memory/**
MEMORY.md

# Any root-level Markdown other than the user-facing docs — catches stray
# session artifacts (e.g. a skill-generated "*Roadmap N.md") that sit
# untracked at the project root and would otherwise leak into the .vsix.
*.md
!README.md
!readme.md
!CHANGELOG.md
!changelog.md
